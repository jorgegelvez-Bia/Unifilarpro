# Copia este archivo como .env y llena los valores. El .env NUNCA se sube a GitHub.

# --- Backend ---
# Orígenes permitidos para el frontend (separados por coma)
CORS_ORIGINS=http://localhost:5173
# Archivo de la base de datos local (mientras no se use Supabase)
UNIFILAR_DB=backend/unifilar.db

# --- Supabase (fase 9) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
